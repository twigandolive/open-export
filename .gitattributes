# The release zip is built with git archive. Everything below is for development
# only and stays out of the zip, so the zip holds just the plugin.

/.gitignore           export-ignore
/.gitattributes       export-ignore
/README.md            export-ignore
/CHANGELOG.md         export-ignore
/ROADMAP.md           export-ignore
/ARCHITECTURE.md      export-ignore
/SECURITY.md          export-ignore
/CLAUDE.md            export-ignore
/AGENTS.md            export-ignore
/tests                export-ignore
/phpunit.xml.dist     export-ignore
/phpcs.xml.dist       export-ignore
/composer.json        export-ignore
/composer.lock        export-ignore
/lib/composer.json    export-ignore
/lib/composer.lock    export-ignore

# WordPress.org listing screenshots. The plugin directory reads them from its own
# assets folder, so they stay out of the zip.
/.wordpress-org       export-ignore

# Developer files inside the bundled SFTP library. The library runs without them.
/lib/vendor/paragonie/random_compat/build-phar.sh         export-ignore
/lib/vendor/paragonie/random_compat/other                 export-ignore
/lib/vendor/paragonie/random_compat/dist                  export-ignore
/lib/vendor/paragonie/random_compat/psalm.xml             export-ignore
/lib/vendor/paragonie/random_compat/psalm-autoload.php    export-ignore
/lib/vendor/paragonie/constant_time_encoding/README.md    export-ignore
/lib/vendor/phpseclib/phpseclib/BACKERS.md                export-ignore
/lib/vendor/phpseclib/phpseclib/README.md                 export-ignore
/lib/vendor/phpseclib/phpseclib/SECURITY.md               export-ignore
/lib/vendor/phpseclib/phpseclib/VERSIONING.md             export-ignore
